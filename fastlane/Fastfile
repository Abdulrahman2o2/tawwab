# Fastfile for Tawwab (تَوَّاب) — alternative to Codemagic for iOS publishing
# Usage: fastlane beta  (builds + uploads to TestFlight)
# Requires: fastlane installed, Apple Developer account, App Store Connect API key

default_platform(:ios)

platform :ios do
  desc "Build the IPA and upload to TestFlight"
  lane :beta do
    # Ensure pods are installed
    cocoapods(
      podfile: "ios/Podfile"
    )

    # Build the app
    build_app(
      workspace: "ios/Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      export_options: {
        method: "app-store-connect",
        signingStyle: "automatic",
        uploadSymbols: true,
        stripSwiftSymbols: true,
      }
    )

    # Upload to TestFlight
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end

  desc "Upload screenshots and metadata to App Store"
  lane :metadata do
    deliver(
      skip_binary_upload: true,
      skip_screenshots: false,
      force: true,
      automatic_release: false,
    )
  end
end
